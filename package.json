{
  "name": "archive-core",
  "version": "0.0.1",
  "description": "ArchiveCore - 在线文档项目后端",
  "author": "qiuye-zhou <https://github.com/qiuye-zhou>",
  "private": true,
  "license": "AGPLv3",
  "repository": {
    "directory": "qiuye-zhou/ArchiveCore",
    "url": "https://github.com/qiuye-zhou/ArchiveCore"
  },
  "homepage": "https://github.com/qiuye-zhou/ArchiveCore#readme",
  "issues": "https://github.com/qiuye-zhou/ArchiveCore/issues",
  "scripts": {
    "dev": "npm run start:dev",
    "debug": "npm run start:debug",
    "pro": "npm run start:prod",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_ENV=production nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development NODE_TEST=test nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.3",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/platform-socket.io": "11.1.8",
    "@nestjs/websockets": "11.1.8",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@typegoose/typegoose": "^12.20.0",
    "@types/jsonwebtoken": "^9.0.10",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^7.2.4",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "class-validator-jsonschema": "^5.1.0",
    "dayjs": "1.11.19",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.5.3",
    "lodash": "^4.17.21",
    "mkdirp": "^3.0.1",
    "mongoose": "^8.19.2",
    "multer": "2.0.2",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.0",
    "rxjs": "^7.8.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cache-manager": "^5.0.0",
    "@types/express": "^5.0.5",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "ioredis": "^5.8.2",
    "jest": "30.2.0",
    "prettier": "^3.6.2",
    "socket.io": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
